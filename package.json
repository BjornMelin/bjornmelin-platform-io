{
  "name": "bjornmelin-platform-io",
  "version": "3.11.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "predev": "node scripts/generate-static-image-variants.mjs",
    "dev": "next dev",
    "generate:csp-hashes": "node scripts/generate-next-inline-csp-hashes.mjs",
    "images:generate": "node scripts/generate-static-image-variants.mjs",
    "prebuild": "node scripts/generate-static-image-variants.mjs",
    "build": "next build && pnpm generate:csp-hashes && pnpm verify:static-404",
    "deps:check-node-types": "node scripts/verify-node-types-version.mjs",
    "start": "pnpm serve",
    "lint": "biome check . --write --error-on-warnings",
    "lint:md": "markdownlint '**/*.md' --dot --ignore-path .gitignore --ignore CHANGELOG.md",
    "lint:md:fix": "markdownlint '**/*.md' --dot --ignore-path .gitignore --ignore CHANGELOG.md --fix",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "type-check": "next typegen && tsc --noEmit -p tsconfig.typecheck.json",
    "env:check": "node --input-type=module -e \"import('./src/env.mjs')\"",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:e2e:docker": "./scripts/run-e2e-tests.sh",
    "test:e2e:setup": "./scripts/setup-e2e.sh",
    "projects:github:refresh": "tsx scripts/refresh-projects-github-metadata.ts",
    "projects:github:check": "tsx scripts/refresh-projects-github-metadata.ts --check",
    "verify:static-404": "node scripts/verify-static-export-404.mjs",
    "docker:build": "docker build -t platform-io:node24 .",
    "docker:smoke": "./scripts/docker-smoke.sh",
    "docker:verify": "pnpm docker:build && pnpm docker:smoke",
    "deploy:static:prod": "node scripts/deploy-static-site.mjs --env prod",
    "serve": "node scripts/serve-static-export.mjs",
    "prepare": "husky",
    "analyze": "next experimental-analyze --output",
    "resend:status": "tsx scripts/ops/resend-domain-manager.ts status",
    "resend:records": "tsx scripts/ops/resend-domain-manager.ts records",
    "resend:verify": "tsx scripts/ops/resend-domain-manager.ts verify",
    "resend:sync-dns": "tsx scripts/ops/resend-domain-manager.ts sync-dns"
  },
  "dependencies": {
    "@aws-sdk/client-ssm": "^3.1090.0",
    "@base-ui/react": "1.6.0",
    "@hookform/resolvers": "^5.4.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "1.25.0",
    "next": "16.2.10",
    "nuqs": "^2.9.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.82.0",
    "resend": "^6.17.2",
    "serve": "14.2.6",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@aws-sdk/client-route-53": "^3.1080.0",
    "@biomejs/biome": "^2.5.2",
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@playwright/test": "~1.61.1",
    "@tailwindcss/postcss": "4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "~6.0.3",
    "@vitest/coverage-v8": "~4.1.10",
    "@vitest/ui": "~4.1.10",
    "commander": "^15.0.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.2",
    "markdownlint-cli": "^0.49.0",
    "msw": "^2.13.4",
    "playwright": "~1.61.1",
    "postcss": "^8.5.16",
    "sharp": "^0.35.3",
    "tailwindcss": "4.3.2",
    "tsx": "^4.23.0",
    "typescript": "~6.0.3",
    "vite": "~8.1.3",
    "vitest": "~4.1.10"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion": "5.0.6",
      "jsdom>undici": "7.28.0",
      "next>postcss": "8.5.16",
      "picomatch": "4.0.4",
      "smol-toml": "1.6.1"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "browserslist": [
    "defaults and fully supports es6-module",
    "not dead"
  ]
}
